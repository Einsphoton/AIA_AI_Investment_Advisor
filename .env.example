# ─── AI Investment Advisor — environment overrides ───────────────────────────
# Copy to `.env` for local runs. Docker Compose reads `.env` automatically.
# All values are optional: the app also stores settings in SQLite via /settings.

# HTTP port for the server (and for the served web UI in production builds)
PORT=8787
HOST=0.0.0.0

# Where SQLite + backups live (inside the container: /data)
DATA_DIR=./data

# log level: fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# ─── LLM (OpenAI-compatible chat completions) ────────────────────────────────
# DeepSeek (default) / OpenAI / Moonshot / Qwen / Ollama / any OpenAI-compatible
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_TIMEOUT_MS=180000

# ─── Optional search providers (leave empty to use zero-key Bing) ────────────
TAVILY_API_KEY=
SERPER_API_KEY=
BRAVE_API_KEY=

# ─── Optional market-data providers (leave empty for zero-key sources) ───────
FINNHUB_API_KEY=
ALPHAVANTAGE_API_KEY=
FMP_API_KEY=

# ─── Docker Compose deployment ───────────────────────────────────────────────
# Image built and published by GitHub Actions on every push (multi-arch amd64/arm64).
# Uncomment to pin a specific build instead of always tracking :latest
# AIA_IMAGE=ghcr.io/einsphoton/aia_ai_investment_advisor:latest
# Host port to publish (docker-compose.yml maps ${HOST_PORT:-8787} → container 8787)
# HOST_PORT=8787

# Web UI dev server port (vite) — only used by `npm run dev`
WEB_PORT=5173
